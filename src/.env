# 环境变量配置

# 识别优化参数
# 识别间隔帧数，每隔几帧做一次特征提取
RECOGNITION_INTERVAL=1

# 连续正确识别超过此帧数后，短暂失败也不变unknown
RECOGNITION_NUM=3

# 同一ID连续unknown达到此帧数才真正当陌生人
UNKNOWN_WARMUP=8

# 目标至少被跟踪多少帧后才开始考虑打码
MIN_TRACK_LENGTH=5

# 跟踪器参数
# 跟踪匹配的IoU阈值，两个框IoU大于此值才认为是同一目标
TRACKER_IOU_THRESHOLD=0.15

# 最大容忍丢失帧数，超过此值则删除轨迹
TRACKER_MAX_MISS=2

# EMA平滑系数，用于平滑跟踪框的抖动
TRACKER_EMA_ALPHA=0.6

# 检测阈值参数
# 置信度阈值，只有置信度大于等于此值的检测框才会被保留
DETECTION_CONFIDENCE=0.3

# NMS（非极大值抑制）的IoU阈值，用于去除重叠的检测框
NMS_IOU_THRESHOLD=0.3
